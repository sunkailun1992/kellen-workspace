# 12个独立仓库：checkout与本机symlink都不属于总仓。
/utils
/rpc-api
/gateway
/user
/ai-agent
/ai
/ai-memory
/rag
/mcp
/message
/report
/admin-web
# 已移出整合范围的历史移动端目录仍须忽略；不删除独立checkout或链接。
/ai-wechat-mini-programs
/.workspace-clone-*/
/.workspace-local/
/.issuerelay/
/dev-scenarios.local.json

# 本机IDE、构建和运行状态；.run/共享入口保留跟踪。
/.idea/
*.iml
.DS_Store
/.gradle/
/build/
/out/
**/__pycache__/
*.py[cod]
/.venv/
/venv/
/node_modules/
/.env
/.env.*
/*.local
/*.local.*

# 本任务本机辅助材料，不公开归档或历史。
.superpowers/

# IDE/agent local memory and JVM crash artifacts.
.remember/
*.hprof
hs_err_pid*.log
replay_pid*.log

# 本机验证产物与私有环境配置；规则适用于所有层级。
*.class
*.log
.env
.env.*
*.env
*.private
*.private.*

# 无凭据的环境示例属于可共享源码，不随私有配置一起忽略。
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template

# IDE 生成文件与编译输出不进入仓库；源码和共享运行配置继续跟踪。
/bin/
/target/
/.classpath
/.project
/.settings/
/.factorypath
/.apt_generated/
